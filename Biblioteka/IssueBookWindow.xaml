<Window x:Class="Biblioteka.IssueBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteka"
        mc:Ignorable="d"
        Title="IssueBookWindow" Height="450" Width="800" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7FA">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выдача книги"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="#B85F85"
                   Margin="5,5,5,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Выберите книгу"/>
            <ComboBox x:Name="BookBox"
                      DisplayMemberPath="Название"
                      SelectedValuePath="КодКниги"
                      Margin="4"
                      Padding="8"/>

            <TextBlock Text="Выберите читателя"/>
            <ComboBox x:Name="ReaderBox"
                      DisplayMemberPath="ФИО"
                      SelectedValuePath="КодЧитателя"
                      Margin="4"
                      Padding="8"/>

            <TextBlock Text="Дата выдачи"/>
            <DatePicker x:Name="BorrowDatePicker"
                        Margin="4"
                        Padding="7"/>

            <TextBlock Text="Предполагаемая дата возврата"/>
            <DatePicker x:Name="ReturnDatePicker"
                        Margin="4"
                        Padding="7"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Отмена"
                    Background="#C9AAB7"
                    Click="Cancel_Click"/>
            <Button Content="Выдать книгу"
                    Click="Issue_Click"/>
        </StackPanel>
    </Grid>
</Window>