<Window x:Class="Biblioteka.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteka"
        mc:Ignorable="d"
        Title="Добавить книгу" Height="450" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7FA">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Новая книга"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="#B85F85"
                   Margin="5,5,5,18"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Название книги"/>
            <TextBox x:Name="TitleBox"/>

            <TextBlock Text="Автор"/>
            <ComboBox x:Name="AuthorBox"
                      DisplayMemberPath="Имя"
                      SelectedValuePath="КодАвтора"
                      Margin="4"
                      Padding="8" SelectionChanged="AuthorBox_SelectionChanged"/>

            <TextBlock Text="Год издания"/>
            <TextBox x:Name="YearBox"/>

            <TextBlock Text="Жанр"/>
            <TextBox x:Name="GenreBox"/>

            <TextBlock Text="Количество страниц"/>
            <TextBox x:Name="PagesBox"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Отмена"
                    Background="#C9AAB7"
                    Click="Cancel_Click" Width="72"/>
            <Button Content="Сохранить"
                    Background="#B85F85"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>