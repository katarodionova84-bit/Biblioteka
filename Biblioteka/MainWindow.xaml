<Window x:Class="Biblioteka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека"
        Height="720"
        Width="1150"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7FA">

    <Window.Resources>
        <SolidColorBrush x:Key="Pink" Color="#D982A5"/>
        <SolidColorBrush x:Key="DarkPink" Color="#B85F85"/>
        <SolidColorBrush x:Key="LightPink" Color="#FCE8F0"/>
        <SolidColorBrush x:Key="TextColor" Color="#493640"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#D982A5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#E8B8CC"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#493640"/>
            <Setter Property="BorderBrush" Value="#F0D5E0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF4F8"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#75465B"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#D982A5">
            <Grid Margin="25,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="БИБЛИОТЕКА"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>

                <TextBlock Text="♡"
                           FontSize="48"
                           Foreground="#FFFFF4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Margin="18"
                Padding="12"
                Background="White"
                CornerRadius="12"
                BorderBrush="#F0D5E0"
                BorderThickness="1">

            <TabControl Background="White"
                        BorderThickness="0">
                <TabItem Header="📚 Книги">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Каталог книг"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#75465B"
                                   Margin="5,10"/>

                        <WrapPanel Grid.Row="1" Margin="0,5">
                            <TextBox x:Name="BookSearch"
                                     Width="280"
                                     ToolTip="Поиск по названию, автору или жанру"
                                     TextChanged="BookSearch_TextChanged"/>
                            <Button Content="Добавить книгу"
                                    Click="AddBook_Click"/>
                            <Button Content="Изменить"
                                    Click="EditBook_Click"/>
                            <Button Content="Удалить"
                                    Click="DeleteBook_Click"/>
                        </WrapPanel>

                        <DataGrid x:Name="BooksGrid"
                                  Grid.Row="2"/>
                    </Grid>
                </TabItem>
                <TabItem Header="✍ Авторы">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Авторы"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#75465B"
                                   Margin="5,10"/>

                        <WrapPanel Grid.Row="1" Margin="0,5">
                            <Button Content="Добавить автора"
                                    Click="AddAuthor_Click"/>
                            <Button Content="Изменить"
                                    Click="EditAuthor_Click"/>
                            <Button Content="Удалить"
                                    Click="DeleteAuthor_Click"/>
                        </WrapPanel>

                        <DataGrid x:Name="AuthorsGrid"
                                  Grid.Row="2"/>
                    </Grid>
                </TabItem>

                <TabItem Header="👤 Читатели">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Читатели библиотеки"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#75465B"
                                   Margin="5,10"/>

                        <WrapPanel Grid.Row="1" Margin="0,5">
                            <Button Content="Добавить читателя"
                                    Click="AddReader_Click"/>
                            <Button Content="Изменить"
                                    Click="EditReader_Click"/>
                            <Button Content="Удалить"
                                    Click="DeleteReader_Click"/>
                        </WrapPanel>

                        <DataGrid x:Name="ReadersGrid"
                                  Grid.Row="2"/>
                    </Grid>
                </TabItem>
                <TabItem Header="📖 Выдача и возврат">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Выдача и возврат книг"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#75465B"
                                   Margin="5,10"/>

                        <WrapPanel Grid.Row="1" Margin="0,5">
                            <Button Content="Выдать книгу"
                                    Click="IssueBook_Click"/>
                            <Button Content="Оформить возврат"
                                    Click="ReturnBook_Click"/>
                            <Button Content="Обновить"
                                    Click="RefreshBorrowed_Click"/>
                        </WrapPanel>

                        <DataGrid x:Name="BorrowedGrid"
                                  Grid.Row="2"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>

    
    </Grid>
</Window>
