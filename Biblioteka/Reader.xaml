<Window x:Class="Biblioteka.Reader"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о читателе"
        Height="650"
        Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7FA">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Информация о читателе"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#B85F85"
                   Margin="5,5,5,18"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="ФИО"
                       Margin="4,5,4,3"/>
            <TextBox x:Name="FullNameBox"
                     Height="32"
                     Padding="6"/>

            <TextBlock Text="Дата рождения (дд.мм.гггг)"
                       Margin="4,10,4,3"/>
            <TextBox x:Name="BirthDateBox"
                     Height="32"
                     Padding="6"/>

            <TextBlock Text="Номер телефона"
                       Margin="4,10,4,3"/>
            <TextBox x:Name="PhoneBox"
                     Height="32"
                     Padding="6"/>

            <TextBlock Text="Электронная почта"
                       Margin="4,10,4,3"/>
            <TextBox x:Name="EmailBox"
                     Height="32"
                     Padding="6"/>

            <TextBlock Text="Пароль"
                       Margin="4,10,4,3"/>
            <PasswordBox x:Name="PasswordInput"
                         Height="38"
                         Padding="7"/>

            <TextBlock Text="Роль"
                       Margin="4,10,4,3"/>
            <ComboBox x:Name="RoleBox"
                      Height="35"
                      Padding="6"
                      SelectedIndex="1" SelectionChanged="RoleBox_SelectionChanged">
                <ComboBoxItem Content="Администратор" Tag="1"/>
                <ComboBoxItem Content="Пользователь" Tag="2"/>
            </ComboBox>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Отмена"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Background="#C9AAB7"
                    Foreground="White"
                    Click="Cancel_Click"/>

            <Button Content="Сохранить"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Background="#D98BAA"
                    Foreground="White"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>