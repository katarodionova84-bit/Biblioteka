<Window x:Class="Biblioteka.Author"       
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация об авторе"
        Height="350"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7FA">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Информация об авторе"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#B85F85"
                   Margin="5,5,5,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Имя и фамилия автора"
                       Margin="5,5,5,8"
                       FontSize="14"
                       Foreground="#80445F"/>

            <TextBox x:Name="NameBox"
                     Height="38"
                     Padding="8"
                     FontSize="14"/>

            <TextBlock Text="Дата рождения (дд.мм.гггг)"
                       Margin="5,15,5,8"
                       FontSize="14"
                       Foreground="#80445F"/>

            <TextBox x:Name="BirthDateBox"
                     Height="38"
                     Padding="8"
                     FontSize="14"
                     Text=""/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Отмена"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Background="#C9AAB7"
                    Click="Cancel_Click"/>

            <Button Content="Сохранить"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Background="#D98BAA"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>